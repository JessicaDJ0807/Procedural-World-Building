# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local Firebase credentials. *.local above does not cover a plain .env,
# and these keys identify a real project even though they are not secret.
.env
.env.*
!.env.example

# Names a specific Firebase project, for the same reason .env is ignored.
# firebase.json carries the deploy config and IS tracked.
.firebaserc
# Emulator and deploy scratch output.
.firebase/
firebase-debug.log
firestore-debug.log

# Firebase agent skills, installed by the CLI. skills-lock.json pins the
# source and a content hash for each one, so the content is restorable the
# way node_modules is from a lockfile. .claude/settings.json stays tracked.
.agents/skills/
.claude/skills/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
