rules_version = '2';

// users/{uid}/configs/{configId}.json
//
// Mirrors the Firestore path so one mental model covers both. The 1 MB ceiling
// is well above a real configuration — a 12-shape stack serialises to a few
// kilobytes — and exists so a compromised client cannot use the bucket as free
// storage.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/configs/{object} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType == 'application/json';
    }
  }
}
