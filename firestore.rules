rules_version = '2';

// users/{uid}/configs/{configId} and users/{uid}/worlds/{worldId}
//
// The owner's uid is in the path, so the check is a path comparison: no
// document can be read or written unless the signed-in uid matches the segment
// it is stored under. There is no query that can span two users, because there
// is no collection that contains two users' documents.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // The user document itself is not used yet; denying it keeps the surface
      // to exactly what the app writes.
      allow read, write: if false;

      match /configs/{configId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;

        // ownerUid is redundant with the path on purpose: it is what makes a
        // document self-describing if it is ever exported. Requiring the two to
        // agree stops a document being written that claims a different owner.
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.ownerUid == uid
          && request.resource.data.topic in ['objects', 'maps', 'voxels', 'shaders', 'distributions', 'paths', 'flow', 'branching']
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.settings is map;
      }

      // users/{uid}/worlds/{worldId}: a saved Wildform world (Build).
      //
      // The same ownership rule as configs. Only what every version of the
      // format will have is checked — owner, name, an integer version — and
      // not the world itself, whose schema will change; the app validates and
      // migrates it when it reads it (src/build/worldState.ts).
      match /worlds/{worldId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;

        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.ownerUid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.version is int;

        // The world's body, in chunks of at most 800,000 characters
        // (src/firebase/worlds.ts): same owner, same path check.
        match /chunks/{chunkId} {
          allow read, delete: if request.auth != null && request.auth.uid == uid;

          allow create, update: if request.auth != null
            && request.auth.uid == uid
            && request.resource.data.ownerUid == uid
            && request.resource.data.data is string
            && request.resource.data.data.size() <= 1000000
            && request.resource.data.index is int;
        }
      }
    }
  }
}
